<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>닉네임 설정 - OTT Swipe</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1><a href="/select" style="text-decoration:none; color:inherit;">OTT-Swipe</a></h1>
        <div class="header-nav">
            <a href="/my-list" class="nav-link">My List</a>
        </div>
    </header>

    <div class="list-page-container" style="max-width: 500px; margin-top: 50px;">
        <h2>닉네임 설정</h2>
        <p style="color: #ccc; margin-bottom: 30px;">
            현재 닉네임: <strong style="color: #e50914;"><%= user.nickname || user.username %></strong>
        </p>

        <form id="nickname-form" style="display: flex; flex-direction: column; gap: 15px;">
            <input type="text" id="nickname" placeholder="새로운 닉네임 입력 (최대 10자)" maxlength="10" required 
                   style="padding: 15px; border-radius: 8px; border: none; background: #333; color: white;">
            
            <button type="submit" class="btn" style="background: #e50914; color: white; padding: 15px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold;">
                변경하기
            </button>
        </form>
    </div>

    <script>
        document.getElementById('nickname-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const nickname = document.getElementById('nickname').value;

            try {
                const response = await fetch('/api/users/set-nickname', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nickname })
                });

                const data = await response.json();
                if (response.ok) {
                    alert(data.message);
                    window.location.href = "/my-list"; // 변경 후 마이리스트로 이동
                } else {
                    alert(data.message || "오류가 발생했습니다.");
                }
            } catch (err) {
                console.error(err);
                alert("서버 통신 오류");
            }
        });
    </script>
</body>
</html>