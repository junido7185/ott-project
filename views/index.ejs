<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTT-Swipe</title>
    <link rel="stylesheet" href="/css/style.css"> 
</head>
<body data-user-id="<%= user ? user._id : '' %>">
    <header>
        <h1><a href="/select" style="text-decoration:none; color:inherit;">OTT-Swipe</a></h1>
        
        <div class="header-nav">
            <a href="/select-ott" class="nav-link">OTT 변경</a>
            <a href="/my-list" class="nav-link">My List</a>
        </div>
    </header>

    <div class="card-container">
        <% if (video) { %>
            <div class="video-card" data-video-id="<%= video._id %>">
                <div class="card-image">
                    <img src="<%= video.posterImageUrl %>" alt="<%= video.title %> 포스터">
                </div>
                
                <div class="card-info">
                    <h2><%= video.title %></h2>
                    <div class="metadata">
                        <span class="ott-tag"><%= video.ottPlatform %></span>
                        <span class="genre-tag"><%= video.genre %></span>
                        <span class="rating-tag" style="color: #ffcc00; margin-left: 8px; font-weight: bold;">
                            ★ <%= video.rating ? video.rating.toFixed(1) : '0.0' %>
                        </span>
                    </div>
                    <hr class="info-divider">
                    <div class="description-wrapper">
                        <p class="description"><%= video.description %></p>
                        <span class="read-more">...더 보기</span>
                    </div>

                    <!-- index.ejs: 설명 밑에 한줄평 영역을 만들고 싶을 때 예시 -->
                    <div class="review-section">
                        <div class="star-rating">
                            <span class="star" data-rating="1">☆</span>
                            <span class="star" data-rating="2">☆</span>
                            <span class="star" data-rating="3">☆</span>
                            <span class="star" data-rating="4">☆</span>
                            <span class="star" data-rating="5">☆</span>
                    </div>
    <p class="selected-rating">평점을 선택하세요</p>
    <textarea class="review-input" placeholder="한줄평을 작성하세요"></textarea>
    <button class="submit-review-btn">등록</button>
  </div>
  
                </div>
            </div>
        <% } else { %>
            <h2>더 이상 볼 비디오가 없습니다.</h2>
        <% } %>
    </div>

    <!-- [삭제] 버튼 영역 제거 -->

    <script src="/js/main.js"></script>
</body>
</html>