<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>영화 검색 - OTT-Swipe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .search-container {
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
        }
        .search-box {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
        }
        .search-box input {
            flex: 1;
            padding: 15px;
            font-size: 16px;
            border: 2px solid #444;
            border-radius: 8px;
            background: #2f2f2f;
            color: #fff;
        }
        .search-box button {
            padding: 15px 30px;
            background: #e50914;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
        .search-results {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 20px;
        }
        .search-item {
            cursor: pointer;
            transition: transform 0.2s;
        }
        .search-item:hover {
            transform: scale(1.05);
        }
        .search-item img {
            width: 100%;
            border-radius: 8px;
            aspect-ratio: 2/3;
            object-fit: cover;
        }
        .search-item h4 {
            color: #fff;
            font-size: 14px;
            margin-top: 10px;
            text-align: center;
        }

        /* 모달 스타일 보정 */
        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .video-modal.active {
            display: flex;
        }
        .modal-content-wrapper {
            display: flex;
            gap: 20px;
            max-width: 90%;
            height: 85vh;
        }
        .info-panel, .review-panel {
            width: 450px;
            background: #2f2f2f;
            border-radius: 12px;
            overflow-y: auto;
        }
        .info-panel {
            overflow-x: hidden;
        }
        .info-padding {
            padding: 20px;
        }
    </style>
</head>
<body>
    <header>
        <h1><a href="/select-ott" style="text-decoration:none; color:inherit;">OTT-Swipe</a></h1>
        <div class="header-nav">
            <a href="/set-nickname" class="nav-link" style="font-size: 14px;">⚙️ 설정</a>
            <a href="/main" class="nav-link">스와이프</a>
            <a href="/my-list" class="nav-link">My List</a>
            <a href="/my-reviews" class="nav-link">내 한줄평</a>
        </div>
    </header>

    <div class="search-container">
        <h2 style="color: #fff;">영화 검색</h2>
        <div class="search-box">
            <input type="text" id="search-input" placeholder="영화 제목을 입력하세요">
            <button onclick="searchMovies()">검색</button>
        </div>

        <div class="search-results" id="search-results"></div>
    </div>

    <div class="video-modal" id="video-modal">
        <button class="close-modal" onclick="closeModal()" style="position: absolute; top: 20px; right: 20px; font-size: 36px; color: #fff; cursor: pointer; background: rgba(0,0,0,0.7); width: 50px; height: 50px; border-radius: 50%; border: none; z-index:1001;">✕</button>
        
        <div class="modal-content-wrapper">
            <div class="info-panel" id="video-detail">
                </div>

            <div class="review-panel" style="padding: 20px; display: flex; flex-direction: column;">
                <div class="our-rating-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="color: #e50914; font-weight: bold;">사이트 내 평점</span>
                    <span id="our-rating-text" style="color: #ffcc00; font-weight: bold; font-size: 14px;">-.-점 (0명 참여)</span>
                </div>
                
                <h3 style="margin-top: 24px; color: #e50914; border-bottom: 2px solid #444; padding-bottom: 10px;">한줄평</h3>
                
                <div style="margin-bottom: 20px;">
                    <div class="rating-input">
                        <input type="radio" name="rating" id="star5" value="5"><label for="star5" class="star-R" title="5.0"></label>
                        <input type="radio" name="rating" id="star4.5" value="4.5"><label for="star4.5" class="star-L" title="4.5"></label>
                        <input type="radio" name="rating" id="star4" value="4"><label for="star4" class="star-R" title="4.0"></label>
                        <input type="radio" name="rating" id="star3.5" value="3.5"><label for="star3.5" class="star-L" title="3.5"></label>
                        <input type="radio" name="rating" id="star3" value="3"><label for="star3" class="star-R" title="3.0"></label>
                        <input type="radio" name="rating" id="star2.5" value="2.5"><label for="star2.5" class="star-L" title="2.5"></label>
                        <input type="radio" name="rating" id="star2" value="2"><label for="star2" class="star-R" title="2.0"></label>
                        <input type="radio" name="rating" id="star1.5" value="1.5"><label for="star1.5" class="star-L" title="1.5"></label>
                        <input type="radio" name="rating" id="star1" value="1"><label for="star1" class="star-R" title="1.0"></label>
                        <input type="radio" name="rating" id="star0.5" value="0.5"><label for="star0.5" class="star-L" title="0.5"></label>
                    </div>

                    <textarea id="review-comment" placeholder="한줄평을 작성하세요 (최대 200자)" style="width: 100%; height: 60px; padding: 10px; border-radius: 8px; background: #1a1a1a; color: #fff; border: 1px solid #555; box-sizing: border-box; resize: none; margin-top: 10px;"></textarea>
                    
                    <button onclick="submitReview()" style="width: 100%; padding: 10px; background: #e50914; color: #fff; border: none; border-radius: 8px; margin-top: 10px; cursor: pointer; font-weight: bold;">등록</button>
                </div>

                <div style="flex: 1; overflow-y: auto;" id="review-list"></div>
            </div>
        </div>
    </div>

    <script>
        let currentVideoId = null;

        // [추가] OTT 링크 생성 함수
        function getOttLink(platform, title) {
            const query = encodeURIComponent(title);
            switch (platform.toLowerCase()) {
                case 'netflix': return `https://www.netflix.com/search?q=${query}`;
                case 'watcha': return `https://watcha.com/search?query=${query}`;
                case 'tving': return `https://www.tving.com/search/total?keyword=${query}`;
                case 'wavve': return `https://www.wavve.com/search/search?searchWord=${query}`;
                default: return '#';
            }
        }

        async function searchMovies() {
            const query = document.getElementById('search-input').value.trim();
            if (!query) {
                alert('검색어를 입력하세요.');
                return;
            }

            try {
                const response = await fetch(`/api/videos/search?q=${encodeURIComponent(query)}`);
                const videos = await response.json();

                const resultsContainer = document.getElementById('search-results');
                if (videos.length === 0) {
                    resultsContainer.innerHTML = '<p style="color: #888;">검색 결과가 없습니다.</p>';
                    return;
                }

                resultsContainer.innerHTML = videos.map(video => `
                    <div class="search-item" onclick='openVideoModal(${JSON.stringify(video).replace(/'/g, "&#39;")})'>
                        <img src="${video.posterImageUrl}" alt="${video.title}">
                        <h4>${video.title}</h4>
                    </div>
                `).join('');
            } catch (err) {
                console.error('검색 실패:', err);
            }
        }

        function openVideoModal(video) {
            currentVideoId = video._id;
            const modal = document.getElementById('video-modal');
            modal.classList.add('active'); // active 클래스로 제어
            
            const ottLink = getOttLink(video.ottPlatform, video.title);

            document.getElementById('video-detail').innerHTML = `
                <img src="${video.posterImageUrl}" style="width: 100%; display:block; min-height:300px; background:#000;">
                <div class="info-padding">
                    <h2 style="color: #fff; margin-top:0;">${video.title}</h2>
                    <div style="margin-bottom:15px;">
                        <a href="${ottLink}" target="_blank" style="text-decoration:none;">
                            <span class="ott-tag" style="background:#e50914; color:#fff; padding:4px 8px; border-radius:4px; font-size:12px; font-weight:bold; cursor:pointer;">${video.ottPlatform} ↗</span>
                        </a>
                        <span style="background:#555; color:#fff; padding:4px 8px; border-radius:4px; font-size:12px; margin-left:8px;">${video.genre}</span>
                        <span style="color:#ffcc00; margin-left:8px; font-weight:bold;">★ ${video.rating ? video.rating.toFixed(1) : '0.0'}</span>
                    </div>
                    <p style="color: #ccc; line-height:1.5;">${video.description}</p>
                </div>
            `;
            
            // 사이트 평점 표시
            const ourRatingText = document.getElementById('our-rating-text');
            const avg = video.ourRating || 0;
            const count = video.reviewCount || 0;
            ourRatingText.textContent = count === 0 ? '아직 평점이 없습니다.' : `${avg.toFixed(1)}점 (${count}명 참여)`;

            // 입력 초기화
            document.querySelectorAll('input[name="rating"]').forEach(r => r.checked = false);
            document.getElementById('review-comment').value = '';

            loadReviews(video._id);
        }

        function closeModal() {
            document.getElementById('video-modal').classList.remove('active');
            currentVideoId = null;
        }

        async function loadReviews(videoId) {
            try {
                const response = await fetch(`/api/reviews/${videoId}`);
                const reviews = await response.json();
                
                const reviewList = document.getElementById('review-list');
                if (reviews.length === 0) {
                    reviewList.innerHTML = '<p style="color: #888; text-align:center; padding-top:20px;">아직 리뷰가 없습니다.</p>';
                    return;
                }

                reviewList.innerHTML = reviews.map(review => `
                    <div style="background: #1a1a1a; padding: 15px; border-radius: 8px; margin-bottom: 10px;">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #fff; font-weight: bold;">${review.username}</span>
                            <span style="color: #ffcc00;">${'★'.repeat(Math.floor(review.rating))}</span>
                        </div>
                        <p style="color: #ccc; margin: 8px 0; line-height:1.4;">${review.comment}</p>
                        <p style="color: #888; font-size: 12px;">${new Date(review.createdAt).toLocaleDateString('ko-KR')}</p>
                    </div>
                `).join('');
            } catch (err) {
                console.error('리뷰 로드 실패:', err);
            }
        }

        async function submitReview() {
            const ratingInput = document.querySelector('input[name="rating"]:checked');
            if (!ratingInput) {
                alert('별점을 선택하세요.');
                return;
            }

            const comment = document.getElementById('review-comment').value.trim();
            if (!comment) {
                alert('한줄평을 작성하세요.');
                return;
            }

            try {
                const response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        videoId: currentVideoId,
                        rating: parseFloat(ratingInput.value), // 반개 단위 float 변환
                        comment
                    })
                });
                if (response.ok) {
                    alert('리뷰가 등록되었습니다!');
                    // 현재 비디오 정보를 다시 가져와서 평점 갱신 (선택사항)
                    loadReviews(currentVideoId);
                } else {
                    alert('리뷰 등록 실패');
                }
            } catch (err) {
                console.error('리뷰 작성 실패:', err);
            }
        }

        // Enter 키로 검색
        document.getElementById('search-input').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchMovies();
        });
    </script>
</body>
</html>