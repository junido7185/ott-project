<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>영화 검색 - OTT-Swipe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .search-container {
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
        }
        .search-box {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
        }
        .search-box input {
            flex: 1;
            padding: 15px;
            font-size: 16px;
            border: 2px solid #444;
            border-radius: 8px;
            background: #2f2f2f;
            color: #fff;
        }
        .search-box button {
            padding: 15px 30px;
            background: #e50914;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
        .search-results {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 20px;
        }
        .search-item {
            cursor: pointer;
            transition: transform 0.2s;
        }
        .search-item:hover {
            transform: scale(1.05);
        }
        .search-item img {
            width: 100%;
            border-radius: 8px;
        }
        .search-item h4 {
            color: #fff;
            font-size: 14px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <header>
        <h1>OTT-Swipe</h1>
        <div style="display: flex; gap: 20px;">
            <a href="/main">스와이프 하러가기</a>
            <a href="/my-list">My List</a>
            <a href="/my-reviews">내 한줄평 보기</a>
        </div>
    </header>

    <div class="search-container">
        <h2 style="color: #fff;">영화 검색</h2>
        <div class="search-box">
            <input type="text" id="search-input" placeholder="영화 제목을 입력하세요">
            <button onclick="searchMovies()">검색</button>
        </div>

        <div class="search-results" id="search-results"></div>
    </div>

    <!-- 비디오 모달 (my-list.ejs에서 복사) -->
    <div class="video-modal" id="video-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; justify-content: center; align-items: center;">
        <button class="close-modal" onclick="closeModal()" style="position: absolute; top: 20px; right: 20px; font-size: 36px; color: #fff; cursor: pointer; background: rgba(0,0,0,0.7); width: 50px; height: 50px; border-radius: 50%; border: none;">✕</button>
        
        <div style="display: flex; gap: 20px; max-width: 90%; height: 85vh;">
            <div style="width: 450px; background: #2f2f2f; border-radius: 12px; overflow-y: auto;" id="video-detail"></div>

            <div style="width: 450px; background: #2f2f2f; border-radius: 12px; padding: 20px; display: flex; flex-direction: column;">
                <h3 style="margin-top: 0; color: #e50914;">한줄평</h3>
                
                <div style="margin-bottom: 20px;">
                    <div style="display: flex; gap: 10px; margin: 10px 0;">
                        <label style="font-size: 30px; color: #ffcc00; cursor: pointer;" onclick="setRating(5)">★</label>
                        <label style="font-size: 30px; color: #ffcc00; cursor: pointer;" onclick="setRating(4)">★</label>
                        <label style="font-size: 30px; color: #ffcc00; cursor: pointer;" onclick="setRating(3)">★</label>
                        <label style="font-size: 30px; color: #ffcc00; cursor: pointer;" onclick="setRating(2)">★</label>
                        <label style="font-size: 30px; color: #ffcc00; cursor: pointer;" onclick="setRating(1)">★</label>
                    </div>
                    <textarea id="review-comment" placeholder="한줄평을 작성하세요" style="width: 100%; height: 60px; padding: 10px; border-radius: 8px; background: #1a1a1a; color: #fff; border: 1px solid #555; box-sizing: border-box;"></textarea>
                    <button onclick="submitReview()" style="width: 100%; padding: 10px; background: #e50914; color: #fff; border: none; border-radius: 8px; margin-top: 10px; cursor: pointer;">등록</button>
                </div>

                <div style="flex: 1; overflow-y: auto;" id="review-list"></div>
            </div>
        </div>
    </div>

    <script>
        let selectedRating = 0;
        let currentVideoId = null;

        function setRating(rating) {
            selectedRating = rating;
        }

        async function searchMovies() {
            const query = document.getElementById('search-input').value.trim();
            if (!query) {
                alert('검색어를 입력하세요.');
                return;
            }

            try {
                const response = await fetch(`/api/videos/search?q=${encodeURIComponent(query)}`);
                const videos = await response.json();

                const resultsContainer = document.getElementById('search-results');
                if (videos.length === 0) {
                    resultsContainer.innerHTML = '<p style="color: #888;">검색 결과가 없습니다.</p>';
                    return;
                }

                resultsContainer.innerHTML = videos.map(video => `
                    <div class="search-item" onclick='openVideoModal(${JSON.stringify(video)})'>
                        <img src="${video.posterImageUrl}" alt="${video.title}">
                        <h4>${video.title}</h4>
                    </div>
                `).join('');
            } catch (err) {
                console.error('검색 실패:', err);
            }
        }

        function openVideoModal(video) {
            currentVideoId = video._id;
            document.getElementById('video-modal').style.display = 'flex';
            
            document.getElementById('video-detail').innerHTML = `
                <img src="${video.posterImageUrl}" style="width: 100%;">
                <div style="padding: 20px;">
                    <h2 style="color: #fff;">${video.title}</h2>
                    <p style="color: #e50914; font-weight: bold;">${video.ottPlatform}</p>
                    <p style="color: #ffcc00;">★ ${video.rating ? video.rating.toFixed(1) : '0.0'}</p>
                    <p style="color: #ccc;">${video.description}</p>
                </div>
            `;

            loadReviews(video._id);
        }

        function closeModal() {
            document.getElementById('video-modal').style.display = 'none';
            selectedRating = 0;
            currentVideoId = null;
        }

        async function loadReviews(videoId) {
            try {
                const response = await fetch(`/api/reviews/${videoId}`);
                const reviews = await response.json();
                
                const reviewList = document.getElementById('review-list');
                if (reviews.length === 0) {
                    reviewList.innerHTML = '<p style="color: #888;">아직 리뷰가 없습니다.</p>';
                    return;
                }

                reviewList.innerHTML = reviews.map(review => `
                    <div style="background: #1a1a1a; padding: 15px; border-radius: 8px; margin-bottom: 10px;">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #fff; font-weight: bold;">${review.username}</span>
                            <span style="color: #ffcc00;">${'★'.repeat(review.rating)}</span>
                        </div>
                        <p style="color: #ccc; margin: 8px 0;">${review.comment}</p>
                        <p style="color: #888; font-size: 12px;">${new Date(review.createdAt).toLocaleDateString('ko-KR')}</p>
                    </div>
                `).join('');
            } catch (err) {
                console.error('리뷰 로드 실패:', err);
            }
        }

        async function submitReview() {
            if (selectedRating === 0) {
                alert('별점을 선택하세요.');
                return;
            }

            const comment = document.getElementById('review-comment').value.trim();
            if (!comment) {
                alert('한줄평을 작성하세요.');
                return;
            }

            try {
                const response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        videoId: currentVideoId,
                        rating: selectedRating,
                        comment
                    })
                });

                if (response.ok) {
                    alert('리뷰가 등록되었습니다!');
                    document.getElementById('review-comment').value = '';
                    selectedRating = 0;
                    loadReviews(currentVideoId);
                }
            } catch (err) {
                console.error('리뷰 작성 실패:', err);
            }
        }

        // Enter 키로 검색
        document.getElementById('search-input').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchMovies();
        });
    </script>
</body>
</html>