<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My List - OTT-Swipe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* 버블 컨테이너 */
        .genre-bubbles {
            position: relative;
            width: 100%;
            height: 80vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 개별 버블 */
        .genre-bubble {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, #e50914, #ff6b6b);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: transform 0.3s ease;
            box-shadow: 0 10px 30px rgba(229, 9, 20, 0.4);
            animation: float 6s ease-in-out infinite;
        }

        .genre-bubble:hover {
            transform: scale(1.15) !important;
            box-shadow: 0 15px 40px rgba(229, 9, 20, 0.6);
        }

        .genre-bubble h3 {
            font-size: 18px;
            margin: 0 0 5px 0;
            color: #fff;
            font-weight: bold;
        }

        .genre-bubble .count {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.8);
        }

        /* 둥둥 떠다니는 애니메이션 */
        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(10px, -10px); }
            50% { transform: translate(-10px, 10px); }
            75% { transform: translate(10px, 5px); }
        }

        /* 비디오 슬라이더 모달 */
        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .video-modal.active {
            display: flex;
        }

        .modal-container {
            display: flex;
            gap: 20px;
            max-width: 90%;
            height: 85vh;
        }

        /* 비디오 카드 (왼쪽) */
        .video-slider {
            position: relative;
            width: 450px;
            background: #2f2f2f;
            border-radius: 12px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .video-slider img {
            width: 100%;
            display: block;
        }

        .video-info {
            padding: 20px;
        }

        .video-info h2 {
            margin: 0 0 10px 0;
            color: #fff;
        }

        .video-info .meta {
            margin-bottom: 15px;
        }

        .video-info .meta span {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            margin-right: 8px;
        }

        .ott-tag { background: #e50914; color: #fff; }
        .genre-tag { background: #555; color: #fff; }
        .rating-tag { color: #ffcc00; font-weight: bold; }

        .video-info p {
            color: #ccc;
            line-height: 1.5;
            font-size: 14px;
        }

        /* 화살표 버튼 */
        .arrow-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.9);
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 24px;
            z-index: 10;
            transition: background 0.2s;
        }

        .arrow-btn:hover {
            background: #fff;
        }

        .arrow-btn.prev { left: 10px; }
        .arrow-btn.next { right: 10px; }

        /* 한줄평 창 (오른쪽) */
        .review-panel {
            width: 450px;
            background: #2f2f2f;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .review-panel h3 {
            margin-top: 0;
            color: #e50914;
            border-bottom: 2px solid #444;
            padding-bottom: 10px;
        }

        .review-form {
            margin-bottom: 20px;
        }

        .rating-input {
            display: flex;
            gap: 10px;
            margin: 10px 0;
        }

        .rating-input input[type="radio"] {
            display: none;
        }

        .rating-input label {
            font-size: 30px;
            color: #555;
            cursor: pointer;
            transition: color 0.2s;
        }

        .rating-input input[type="radio"]:checked ~ label,
        .rating-input label:hover,
        .rating-input label:hover ~ label {
            color: #ffcc00;
        }

        .review-form textarea {
            width: 100%;
            height: 60px;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #555;
            background: #1a1a1a;
            color: #fff;
            resize: none;
            font-size: 14px;
            box-sizing: border-box;
        }

        .review-form button {
            width: 100%;
            padding: 10px;
            background: #e50914;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            margin-top: 10px;
        }

        .review-form button:hover {
            background: #c50813;
        }

        .review-list {
            flex: 1;
            overflow-y: auto;
        }

        .review-item {
            background: #1a1a1a;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .review-user {
            color: #fff;
            font-weight: bold;
        }

        .review-rating {
            color: #ffcc00;
        }

        .review-comment {
            color: #ccc;
            font-size: 14px;
            line-height: 1.4;
        }

        .review-date {
            color: #888;
            font-size: 12px;
            margin-top: 8px;
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 36px;
            color: #fff;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.7);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            border: none;
            z-index: 1001;
        }

        .empty-message {
            text-align: center;
            color: #888;
            font-size: 18px;
        }
    </style>
</head>
<body>
    <header>
        <h1>OTT-Swipe</h1>
        <div style="display: flex; gap: 20px; align-items: center;">
            <a href="/">스와이프 하러가기</a>
            <a href="/search">영화 검색</a>
            <a href="/my-reviews">내 한줄평 보기</a>
        </div>
    </header>

    <div class="list-page-container">
        <h2>My Liked Videos by Genre</h2>
        <hr>

        <script type="application/json" id="videos-data">
            <%- JSON.stringify(videos) %>
        </script>

        <div class="genre-bubbles" id="genre-bubbles">
            <!-- JavaScript로 동적 생성 -->
        </div>

        <div class="empty-message" id="empty-message" style="display: none;">
            아직 좋아요를 누른 영상이 없습니다.
        </div>
    </div>

    <!-- 비디오 모달 -->
    <div class="video-modal" id="video-modal">
        <button class="close-modal" onclick="closeModal()">✕</button>
        
        <div class="modal-container">
            <!-- 비디오 슬라이더 -->
            <div class="video-slider" id="video-slider">
                <button class="arrow-btn prev" onclick="prevVideo()">‹</button>
                <button class="arrow-btn next" onclick="nextVideo()">›</button>
                
                <div id="current-video">
                    <!-- 비디오 정보 표시 -->
                </div>
            </div>

            <!-- 한줄평 패널 -->
            <div class="review-panel">
                <h3>한줄평</h3>
                
                <div class="review-form">
                    <div class="rating-input">
                        <input type="radio" name="rating" id="star5" value="5">
                        <input type="radio" name="rating" id="star4" value="4">
                        <input type="radio" name="rating" id="star3" value="3">
                        <input type="radio" name="rating" id="star2" value="2">
                        <input type="radio" name="rating" id="star1" value="1">
                        <label for="star5">★</label>
                        <label for="star4">★</label>
                        <label for="star3">★</label>
                        <label for="star2">★</label>
                        <label for="star1">★</label>
                    </div>
                    <textarea id="review-comment" placeholder="한줄평을 작성하세요 (최대 200자)"></textarea>
                    <button onclick="submitReview()">등록</button>
                </div>

                <div class="review-list" id="review-list">
                    <!-- 리뷰 목록 -->
                </div>
            </div>
        </div>
    </div>

    <script>
        const videosData = document.getElementById('videos-data');
        const videos = videosData ? JSON.parse(videosData.textContent) : [];

        let currentGenre = '';
        let currentGenreVideos = [];
        let currentVideoIndex = 0;

        // 장르별 분류
        function groupByGenre(videos) {
            const genreMap = {};
            videos.forEach(video => {
                const genres = video.genre.split(',').map(g => g.trim());
                genres.forEach(genre => {
                    if (!genreMap[genre]) genreMap[genre] = [];
                    genreMap[genre].push(video);
                });
            });
            return genreMap;
        }

        // 버블 크기 계산 (현재 데이터 기준)
        function calculateBubbleSize(count, maxCount) {
            const minSize = 80;
            const maxSize = 200;
            // 현재 데이터의 최대값을 기준으로 비율 계산
            return minSize + (count / maxCount) * (maxSize - minSize);
        }

        // 불규칙한 위치 계산
        function getRandomPosition(size, containerWidth, containerHeight, existingBubbles) {
            let x, y, attempts = 0;
            const maxAttempts = 50;

            do {
                x = Math.random() * (containerWidth - size);
                y = Math.random() * (containerHeight - size);
                attempts++;

                // 겹침 체크
                const overlap = existingBubbles.some(bubble => {
                    const dx = x - bubble.x;
                    const dy = y - bubble.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    return distance < (size + bubble.size) / 2 + 20; // 20px 여유
                });

                if (!overlap || attempts >= maxAttempts) break;
            } while (true);

            return { x, y };
        }

        // 버블 렌더링
        function renderBubbles() {
            const container = document.getElementById('genre-bubbles');
            const emptyMessage = document.getElementById('empty-message');

            if (videos.length === 0) {
                emptyMessage.style.display = 'block';
                return;
            }

            const genreMap = groupByGenre(videos);
            const genres = Object.keys(genreMap);

            if (genres.length === 0) {
                emptyMessage.style.display = 'block';
                return;
            }

            const containerRect = container.getBoundingClientRect();
            const existingBubbles = [];

            // [추가] 현재 데이터에서 최대 개수 찾기
            const maxCount = Math.max(...genres.map(genre => genreMap[genre].length));

            genres.forEach(genre => {
                const count = genreMap[genre].length;
                const size = calculateBubbleSize(count, maxCount); // [수정] maxCount 전달
                const pos = getRandomPosition(size, containerRect.width, containerRect.height, existingBubbles);

                existingBubbles.push({ x: pos.x, y: pos.y, size });

                const bubble = document.createElement('div');
                bubble.className = 'genre-bubble';
                bubble.style.width = `${size}px`;
                bubble.style.height = `${size}px`;
                bubble.style.left = `${pos.x}px`;
                bubble.style.top = `${pos.y}px`;
                bubble.style.animationDelay = `${Math.random() * 2}s`; // 랜덤 딜레이
                bubble.innerHTML = `
                    <h3>${genre}</h3>
                    <span class="count">${count}개</span>
                `;

                bubble.addEventListener('click', () => openModal(genre, genreMap[genre]));
                container.appendChild(bubble);
            });
        }

        // 모달 열기
        function openModal(genre, videos) {
            currentGenre = genre;
            currentGenreVideos = videos.sort((a, b) => (b.rating || 0) - (a.rating || 0)); // 평점 높은 순
            currentVideoIndex = 0;

            document.getElementById('video-modal').classList.add('active');
            showCurrentVideo();
        }

        // 현재 비디오 표시
        function showCurrentVideo() {
            const video = currentGenreVideos[currentVideoIndex];
            const container = document.getElementById('current-video');

            container.innerHTML = `
                <img src="${video.posterImageUrl}" alt="${video.title}">
                <div class="video-info">
                    <h2>${video.title}</h2>
                    <div class="meta">
                        <span class="ott-tag">${video.ottPlatform}</span>
                        <span class="genre-tag">${video.genre}</span>
                        <span class="rating-tag">★ ${video.rating ? video.rating.toFixed(1) : '0.0'}</span>
                    </div>
                    <p>${video.description}</p>
                    <p style="color: #888; font-size: 12px; margin-top: 10px;">
                        ${currentVideoIndex + 1} / ${currentGenreVideos.length}
                    </p>
                </div>
            `;

            loadReviews(video._id);
        }

        // 이전 비디오
        function prevVideo() {
            if (currentVideoIndex > 0) {
                currentVideoIndex--;
                showCurrentVideo();
            }
        }

        // 다음 비디오
        function nextVideo() {
            if (currentVideoIndex < currentGenreVideos.length - 1) {
                currentVideoIndex++;
                showCurrentVideo();
            }
        }

        // 리뷰 로드
        async function loadReviews(videoId) {
            try {
                const response = await fetch(`/api/reviews/${videoId}`);
                const reviews = await response.json();
                
                const reviewList = document.getElementById('review-list');
                if (reviews.length === 0) {
                    reviewList.innerHTML = '<p class="empty-message">아직 리뷰가 없습니다.</p>';
                    return;
                }

                reviewList.innerHTML = reviews.map(review => `
                    <div class="review-item">
                        <div class="review-header">
                            <span class="review-user">${review.username}</span>
                            <span class="review-rating">${'★'.repeat(review.rating)}</span>
                        </div>
                        <p class="review-comment">${review.comment}</p>
                        <p class="review-date">${new Date(review.createdAt).toLocaleDateString('ko-KR')}</p>
                    </div>
                `).join('');
            } catch (err) {
                console.error('리뷰 로드 실패:', err);
            }
        }

        // 리뷰 작성
        async function submitReview() {
            const rating = document.querySelector('input[name="rating"]:checked');
            const comment = document.getElementById('review-comment').value.trim();

            if (!rating) {
                alert('별점을 선택해주세요.');
                return;
            }

            if (!comment) {
                alert('한줄평을 작성해주세요.');
                return;
            }

            if (comment.length > 200) {
                alert('한줄평은 200자 이하로 작성해주세요.');
                return;
            }

            const video = currentGenreVideos[currentVideoIndex];

            try {
                const response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        videoId: video._id,
                        rating: parseInt(rating.value),
                        comment
                    })
                });

                if (response.ok) {
                    alert('리뷰가 등록되었습니다!');
                    document.getElementById('review-comment').value = '';
                    document.querySelectorAll('input[name="rating"]').forEach(r => r.checked = false);
                    loadReviews(video._id);
                } else {
                    alert('리뷰 등록에 실패했습니다.');
                }
            } catch (err) {
                console.error('리뷰 작성 실패:', err);
            }
        }

        // 모달 닫기
        function closeModal() {
            document.getElementById('video-modal').classList.remove('active');
        }

        // 초기화
        renderBubbles();

        // 모달 외부 클릭 시 닫기
        document.getElementById('video-modal').addEventListener('click', (e) => {
            if (e.target.id === 'video-modal') {
                closeModal();
            }
        });
    </script>
</body>
</html>